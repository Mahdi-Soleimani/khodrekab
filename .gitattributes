# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit source code text handling
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Explicit binary assets (prevent diff corruption and line-ending mangling)
*.webp binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff2 binary
*.glb binary
