[Unit]
Description=Carno Production SMS Worker Daemon (Singleton)
After=network.target redis.service
Wants=redis.service

[Service]
Type=simple
User=carno
Group=carno
WorkingDirectory=/var/www/carno
EnvironmentFile=/var/www/carno/.env
ExecStart=/usr/bin/npm run worker:sms
Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=25s
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=carno-sms-worker

[Install]
WantedBy=multi-user.target
