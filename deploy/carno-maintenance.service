[Unit]
Description=Carno PostgreSQL OTP Retention Maintenance Runner
After=network.target postgresql.service

[Service]
Type=oneshot
User=carno
Group=carno
WorkingDirectory=/var/www/carno
EnvironmentFile=/var/www/carno/.env
ExecStart=/usr/bin/npm run maintenance:otp
StandardOutput=journal
StandardError=journal
SyslogIdentifier=carno-maintenance
