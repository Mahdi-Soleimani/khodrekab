# ==============================================================================
# CARNO / KHODREKAB.IR — RUNFLARE PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# NOTE: This file contains sanitized placeholders. DO NOT commit actual secrets.
# Configure these variables in Runflare Dashboard: Project -> Settings -> Variables / Secrets.
#
# Production Architecture: Single Docker Service with Runflare Persistent Disk mounted at /var/lib/carno-data
# All database & Redis listeners bind strictly to 127.0.0.1 (Loopback).
# Public Domain: https://khodrekab.ir
# ==============================================================================

# Core Runtime
NODE_ENV=production
PORT=3000
CARNO_DATA_DIR=/var/lib/carno-data

# Persistent PostgreSQL (Least-Privilege Split)
# Generate high-entropy passwords (e.g. openssl rand -hex 24)
CARNO_APP_DB_PASSWORD=your_production_carno_app_password
CARNO_MIGRATOR_DB_PASSWORD=your_production_carno_migrator_password
DATABASE_URL=postgresql://carno_app:your_production_carno_app_password@127.0.0.1:5432/carlanding?schema=public&connection_limit=15&pool_timeout=10&connect_timeout=5
MIGRATION_DATABASE_URL=postgresql://carno_migrator:your_production_carno_migrator_password@127.0.0.1:5432/carlanding?schema=public

# Persistent Redis (Authenticated Loopback)
# Generate a strong password (e.g. openssl rand -hex 24)
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=your_production_redis_password

# SMS Gateway — MeliPayamak (BaseServiceNumber / OTP Pattern)
MELIPAYAMAK_USERNAME=your_melipayamak_username
MELIPAYAMAK_PASSWORD=your_melipayamak_password_or_apikey
MELIPAYAMAK_BODY_ID=your_approved_pattern_id
# Optional: only required if general advertising SMS (SendSMS) is used
MELIPAYAMAK_FROM=

# Card-to-Card Payment Settings
PAYMENT_CARD_NUMBER=6037-xxxx-xxxx-xxxx
PAYMENT_CARD_HOLDER_NAME=مهدی سلیمانی
# High-entropy secret for authenticating payment confirmation webhooks
PAYMENT_WEBHOOK_SECRET=your_production_payment_webhook_secret

# n8n Automation Engine (Internal 127.0.0.1 only, persistent in /var/lib/carno-data/n8n)
ENABLE_N8N=true
# Stable encryption key for credentials stored in n8n (DO NOT casually rotate)
N8N_ENCRYPTION_KEY=your_production_n8n_encryption_key_min32chars
N8N_AUTH_SECRET=your_production_n8n_admin_password
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/payment-confirmed
N8N_WEBHOOK_URL_SEND_OTP=http://127.0.0.1:5678/webhook/send-otp
N8N_WEBHOOK_URL_VERIFY_OTP=http://127.0.0.1:5678/webhook/verify-otp

# Public Web URL & Analytics
NEXT_PUBLIC_BASE_URL=https://khodrekab.ir
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# Application Business Parameters
WAITLIST_BASE_OFFSET=300
OTP_EXPIRY_SECONDS=120
EARLY_ACCESS_PRICE=299000
PAYMENT_TIMEOUT_MINUTES=15

# Security Hardening & Rate Limiting
SMS_KILL_SWITCH=false
SMS_GLOBAL_HOURLY_CAP=60
SMS_GLOBAL_DAILY_CAP=300
SMS_IP_HOURLY_CAP=20
SMS_PHONE_HOURLY_CAP=10
SMS_PHONE_DAILY_CAP=10
TRUSTED_IP_HEADER=x-forwarded-for
TRUSTED_PROXY_CIDRS=

# Cryptographic Keys & Peppers (64-character hex strings: openssl rand -hex 32)
POW_SECRET_PEPPER=your_production_64char_hex_pow_pepper
OTP_PEPPER=your_production_64char_hex_otp_pepper
SMS_ENCRYPTION_KEY=your_production_64char_hex_sms_payload_key
JWT_SECRET=your_production_64char_hex_jwt_secret

# Anti-Brute-Force Lockout
OTP_LOCKOUT_MAX_ATTEMPTS=10
OTP_LOCKOUT_DURATION_SECONDS=1800
