# ==============================================================================
# CARNO / KHODREKAB.IR — LOCAL DEVELOPMENT ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy to .env and adjust credentials if needed.
# For local development with Docker Compose, ports 5433 (Postgres), 6380 (Redis),
# and 5678 (n8n) are mapped to localhost.
# ==============================================================================

# Database (Local Docker Compose publishes port 5433)
DATABASE_URL=postgresql://carno_app:your_app_password@localhost:5433/carlanding?schema=public&connection_limit=15&pool_timeout=10&connect_timeout=5
MIGRATION_DATABASE_URL=postgresql://carno_migrator:your_migrator_password@localhost:5433/carlanding?schema=public
SHADOW_DATABASE_URL=postgresql://carno_migrator:your_migrator_password@localhost:5433/carlanding_shadow?schema=public
# Database Passwords (KHODREKAB_* is primary, legacy CARNO_* is supported as fallback)
KHODREKAB_APP_DB_PASSWORD=your_app_password
KHODREKAB_MIGRATOR_DB_PASSWORD=your_migrator_password
# CARNO_APP_DB_PASSWORD=your_app_password (Supported as legacy fallback)
# CARNO_MIGRATOR_DB_PASSWORD=your_migrator_password (Supported as legacy fallback)

# Redis (Local Docker Compose publishes 127.0.0.1:6380)
REDIS_URL=redis://127.0.0.1:6380
REDIS_PASSWORD_FILE=./secrets/redis_password.txt

# SMS - MeliPayamak (BaseServiceNumber / Service Pattern Line)
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_BODY_ID=
# Optional: only required if general advertising SMS (SendSMS) is used
MELIPAYAMAK_FROM=

# Payment
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER_NAME=
PAYMENT_WEBHOOK_SECRET=

# n8n (Local Docker Compose publishes 5678)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/payment-confirmed
N8N_WEBHOOK_URL_SEND_OTP=http://localhost:5678/webhook/send-otp
N8N_WEBHOOK_URL_VERIFY_OTP=http://localhost:5678/webhook/verify-otp
N8N_AUTH_SECRET=changeme_to_secure_secret
N8N_ENCRYPTION_KEY=

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# App & Waitlist
NEXT_PUBLIC_BASE_URL=http://localhost:3000
WAITLIST_BASE_OFFSET=300
OTP_EXPIRY_SECONDS=120
EARLY_ACCESS_PRICE=299000
PAYMENT_TIMEOUT_MINUTES=15

# Security Hardening & Rate Limiting
SMS_KILL_SWITCH=false
SMS_GLOBAL_HOURLY_CAP=60
SMS_GLOBAL_DAILY_CAP=300
SMS_IP_HOURLY_CAP=20
SMS_PHONE_HOURLY_CAP=10
SMS_PHONE_DAILY_CAP=10
TRUSTED_IP_HEADER=
TRUSTED_PROXY_CIDRS=

# Cryptographic Keys & Peppers (64-character hex strings in production)
POW_SECRET_PEPPER=
OTP_PEPPER=
SMS_ENCRYPTION_KEY=
JWT_SECRET=
JWT_DEV_SECRET=

# Anti-Brute-Force Lockout
OTP_LOCKOUT_MAX_ATTEMPTS=10
OTP_LOCKOUT_DURATION_SECONDS=1800
